{
  "name": "ensis-ui",
  "version": "3.0.3",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Vue 3 workbench design system — Rs* components, --rs-* tokens, optional Monaco / CodeMirror / xterm",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "design-system",
    "workbench",
    "ensis"
  ],
  "author": "Blair-Shang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blair-Shang/ensis-ui.git"
  },
  "homepage": "https://blair-shang.github.io/ensis-ui/",
  "bugs": {
    "url": "https://github.com/Blair-Shang/ensis-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./brand-icons.css": "./dist/brand-icons.css",
    "./vite-plugins/monaco-zh-nls": {
      "types": "./dist/vite-plugins/monaco-zh-nls.d.ts",
      "import": "./dist/vite-plugins/monaco-zh-nls.js",
      "default": "./dist/vite-plugins/monaco-zh-nls.js"
    },
    "./vite-plugins/silence-antlr-parse-console": {
      "types": "./dist/vite-plugins/silence-antlr-parse-console.d.ts",
      "import": "./dist/vite-plugins/silence-antlr-parse-console.js",
      "default": "./dist/vite-plugins/silence-antlr-parse-console.js"
    },
    "./vite-plugins/ensis-ui-host": {
      "types": "./dist/vite-plugins/ensis-ui-host.d.ts",
      "import": "./dist/vite-plugins/ensis-ui-host.js",
      "default": "./dist/vite-plugins/ensis-ui-host.js"
    },
    "./vite-plugins/rewrite-named-imports": {
      "types": "./dist/vite-plugins/rewrite-named-imports.d.ts",
      "import": "./dist/vite-plugins/rewrite-named-imports.js",
      "default": "./dist/vite-plugins/rewrite-named-imports.js"
    },
    "./vite-prebundle/codemirror": "./dist/dev/vite-codemirror-deps.js",
    "./vite-prebundle/xterm": "./dist/dev/vite-xterm-deps.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "dev:site": "vite --config site/vite.config.ts",
    "build": "node scripts/build-lib.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "node scripts/build-lib.mjs",
    "build:playground": "vite build --config playground/vite.config.ts",
    "preview:playground": "vite preview --config playground/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "preview:site": "vite preview --config site/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run src/components/table/__tests__/RsTable.perf.spec.ts src/components/table/__tests__/useRsTableCore.perf.spec.ts",
    "test:compat": "vitest run src/components/table/__tests__/rs-table-compat-matrix.spec.ts src/components/table/__tests__/rs-table-api.spec.ts src/components/table/__tests__/rs-table-isolation.spec.ts",
    "test:ssr": "vitest run src/components/table/__tests__/RsTable.ssr.spec.ts",
    "test:dom-baseline": "vitest run src/components/table/__tests__/RsTable.dom-baseline.spec.ts src/components/table/__tests__/rs-table-echarts-adapter.spec.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "peerDependencies": {
    "vite": ">=5",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@lucide/vue": "^1.31.0",
    "@rollup/pluginutils": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.13",
    "es-module-lexer": "^1.7.0",
    "magic-string": "^0.30.17",
    "marked": "^18.0.9",
    "monaco-editor": "^0.55.1",
    "monaco-sql-languages": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/server-renderer": "^3.5.39",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
